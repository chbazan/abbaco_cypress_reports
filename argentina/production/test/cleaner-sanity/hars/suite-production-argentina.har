          "content": {
            "size": 1043,
            "mimeType": "application/json",
            "text": "{\"items\":[{\"announcement_date\":\"2026-04-08 00:00:00.000Z\",\"body\":\"Ampliamos los portafolios de tu plan sin cambiar el precio. Avanzado: hasta 3. Experto: hasta 6. Corporativo: hasta 6 y más a pedido. Más espacio para tus inversiones en renta fija.\",\"collectionId\":\"pbc_3866499052\",\"collectionName\":\"announcements\",\"created\":\"2026-04-08 19:58:16.986Z\",\"details_url\":\"\",\"id\":\"1bqvtrpd31k40y4\",\"title\":\"¡Buenas noticias!\",\"type\":\"improvement\",\"updated\":\"2026-04-08 19:58:16.986Z\"},{\"announcement_date\":\"2026-03-12 00:00:00.000Z\",\"body\":\"Esta es la nueva interfaz de notificaciones en Abbaco. Ahora vas a ver mejoras, nuevas funciones y novedades del producto anunciadas directamente acá, para que estés siempre al día y sin perder foco.\",\"collectionId\":\"pbc_3866499052\",\"collectionName\":\"announcements\",\"created\":\"2026-03-12 20:55:44.931Z\",\"details_url\":\"\",\"id\":\"yyv1kaaaaajso8d\",\"title\":\"Nueva sección de notificaciones en abbaco!\",\"type\":\"new-feature\",\"updated\":\"2026-03-12 20:55:44.931Z\"}],\"page\":1,\"perPage\":500,\"totalItems\":2,\"totalPages\":1}"
          },
